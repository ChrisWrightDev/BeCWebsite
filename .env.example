# Stripe checkout integration (required for checkout flows)
NUXT_STRIPE_SECRET_KEY=sk_test_xxx
NUXT_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Supabase integration (required for production-like data-backed previews)
# Shop APIs fall back to safe local preview data when URL/service role are omitted.
NUXT_SUPABASE_URL=https://your-project.supabase.co
NUXT_SUPABASE_ANON_KEY=your-supabase-anon-key
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe webhook signing secret (Developers → Webhooks → signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Order and inquiry email via Resend. If unset, orders still save and email is skipped.
RESEND_API_KEY=re_xxx
EMAIL_FROM=Blue Eyed Clowns <onboarding@resend.dev>
